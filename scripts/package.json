    "build:eval-api": "esbuild src/eval-api.js --bundle --platform=node --target=node18 --outfile=eval-api.bundle.js --format=cjs --external:keytar --external:@azure/msal-node-extensions --banner:js=\"var _sf=require('fs'),_sp=require('path'),_sr=function(n){try{var v=JSON.parse(_sf.readFileSync(_sp.join(require('os').homedir(),'.copilot-studio-cli',n),'utf8')).pluginData;if(typeof v=='string'&&_sf.existsSync(v))return v}catch{}},_so=function(x){return x&&_sf.existsSync(_sp.join(x,'native-deps.json'))&&x},_sd=process.env.SFCS_PLUGIN_DATA||_sr('sfcs-plugin-paths.json')||_so(process.env.CLAUDE_PLUGIN_DATA)||_so(_sr('plugin-paths.json'));if(_sd){process.env.NODE_PATH=[_sp.join(_sd,'node_modules'),process.env.NODE_PATH].filter(Boolean).join(_sp.delimiter);require('module')._initPaths()}\"",
